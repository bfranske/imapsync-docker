# Docker image tag. Pin this to a version for repeatable migrations.
IMAPSYNC_IMAGE=bfranske/imapsync:latest

# Source mailbox
IMAPSYNC_HOST1=imap.source.example
IMAPSYNC_PORT1=993
IMAPSYNC_USER1=source-user@example.com
IMAPSYNC_PASSWORD1=replace-with-source-password
IMAPSYNC_SSL1=true

# Destination mailbox
IMAPSYNC_HOST2=imap.destination.example
IMAPSYNC_PORT2=993
IMAPSYNC_USER2=destination-user@example.com
IMAPSYNC_PASSWORD2=replace-with-destination-password
IMAPSYNC_SSL2=true

# Optional runtime behavior
# Logs are written to ./logs by Docker Compose.
# IMAPSYNC_MAXAGE=30
# IMAPSYNC_MAX_BYTES_PER_SECOND=1000000
# IMAPSYNC_MAX_MESSAGES_PER_SECOND=10
# IMAPSYNC_EXCLUDE=Archive
# IMAPSYNC_DELETE2=false
# IMAPSYNC_NOFOLDERSIZES=false