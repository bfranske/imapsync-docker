# Copy this file to .env only when the source or destination server is not using TLS.
IMAPSYNC_IMAGE=bfranske/imapsync:latest

IMAPSYNC_HOST1=imap.source.example
IMAPSYNC_PORT1=143
IMAPSYNC_USER1=source-user@example.com
IMAPSYNC_PASSWORD1=replace-with-source-password
IMAPSYNC_SSL1=false
IMAPSYNC_TIMEOUT1=180

IMAPSYNC_HOST2=imap.destination.example
IMAPSYNC_PORT2=143
IMAPSYNC_USER2=destination-user@example.com
IMAPSYNC_PASSWORD2=replace-with-destination-password
IMAPSYNC_SSL2=false
IMAPSYNC_TIMEOUT2=180

# Destructive option: removes destination messages absent from the source.
IMAPSYNC_DELETE2=false
# Reduces mailbox scan overhead for large migrations.
IMAPSYNC_NOFOLDERSIZES=true